---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const apk = 'https://github.com/rito27959-arch/Boomparty/releases/download/apk/BoomParty.apk';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/hero.webp" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/img/hero.webp" type="image/webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <header class="gnav">
      <nav class="gnav-in" aria-label="Navigation principale">
        <a class="wordmark" href="/">BOOM PARTY</a>
        <ul class="gnav-links">
          <li><a href="/#jeu">Le jeu</a></li>
          <li><a href="/#comment">Comment jouer</a></li>
          <li><a href="/#personnalites">Personnalités</a></li>
          <li><a href="/#modes">Modes</a></li>
          <li><a href="/#vie-privee">Vie privée</a></li>
        </ul>
        <a class="gnav-cta" href={apk}>Télécharger</a>
      </nav>
      <div class="fuse" aria-hidden="true"><span class="fuse-burn"></span><span class="fuse-spark"></span></div>
    </header>

    <main><slot /></main>

    <a class="dock" href={apk} data-confetti aria-label="Télécharger BOOM PARTY pour Android">
      <img src="/img/happy.webp" width="44" height="52" alt="" />
      <span><strong>BOOM PARTY</strong><small>Gratuit · Android</small></span>
      <span class="dock-btn">Télécharger</span>
    </a>
    <canvas class="confetti" aria-hidden="true"></canvas>

    <footer class="foot">
      <div class="foot-in">
        <p class="foot-note">
          BOOM PARTY fonctionne sur Android 7.0 et versions ultérieures. La reconnaissance vocale hors ligne demande un
          téléchargement unique d’environ 210 Mo, de préférence en Wi‑Fi. Sans ce pack, le jeu utilise la reconnaissance
          vocale du téléphone.
        </p>
        <div class="foot-cols">
          <div>
            <h3>Jouer</h3>
            <a href={apk}>Télécharger pour Android</a>
            <a href="/#comment">Comment jouer</a>
            <a href="/#modes">Modes de jeu</a>
          </div>
          <div>
            <h3>La bombe</h3>
            <a href="/#personnalites">Personnalités</a>
            <a href="/#expressions">Expressions</a>
            <a href="/#skins">Skins</a>
          </div>
          <div>
            <h3>À propos</h3>
            <a href="/confidentialite">Confidentialité</a>
            <a href="/confidentialite#licences">Données et licences</a>
          </div>
        </div>
        <p class="foot-legal">
          Base de mots issue de Wikidata (CC0). Voix de synthèse Piper « siwis » (corpus SIWIS, CC BY 4.0).
          Reconnaissance vocale sherpa‑onnx (Apache‑2.0). © 2026 BOOM PARTY.
        </p>
      </div>
    </footer>

    <script>
      // Mèche de progression : elle brûle au fil du défilement.
      const root = document.documentElement;
      const update = () => {
        const max = root.scrollHeight - innerHeight;
        root.style.setProperty('--burn', String(max > 0 ? Math.min(1, scrollY / max) : 0));
      };
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();

      // barre de téléchargement flottante (téléphone), après l'ouverture
      const dock = document.querySelector<HTMLElement>('.dock')!;
      const hero = document.querySelector<HTMLElement>('.sb');
      const showDock = () => dock.classList.toggle('on', scrollY > (hero ? hero.offsetTop + hero.offsetHeight - innerHeight * 0.5 : innerHeight) && root.scrollHeight - scrollY - innerHeight > 500);
      addEventListener('scroll', showDock, { passive: true });
      showDock();

      // confettis au clic sur un bouton de téléchargement
      const cv = document.querySelector<HTMLCanvasElement>('.confetti')!;
      const cx = cv.getContext('2d')!;
      type C = { x: number; y: number; vx: number; vy: number; r: number; s: number; c: string; l: number };
      let bits: C[] = [];
      let anim = 0;
      const colors = ['#ff7a18', '#ffd23f', '#ff4d6d', '#4dabf7', '#9775fa', '#51cf66'];
      const frame = () => {
        cx.clearRect(0, 0, cv.width, cv.height);
        bits = bits.filter((b) => b.l > 0);
        for (const b of bits) {
          b.x += b.vx; b.y += b.vy; b.vy += 0.25; b.vx *= 0.99; b.r += b.s; b.l -= 0.008;
          cx.save(); cx.globalAlpha = Math.min(1, b.l * 2); cx.translate(b.x, b.y); cx.rotate(b.r);
          cx.fillStyle = b.c; cx.fillRect(-5, -3, 10, 6); cx.restore();
        }
        anim = bits.length ? requestAnimationFrame(frame) : 0;
      };
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLElement>('[data-confetti]');
        if (!a || reduceMotion) return;
        cv.width = innerWidth; cv.height = innerHeight;
        const r = a.getBoundingClientRect();
        for (let i = 0; i < 140; i++) {
          const ang = -Math.PI / 2 + (Math.random() - 0.5) * 2.4, sp = 6 + Math.random() * 12;
          bits.push({ x: r.left + r.width / 2, y: r.top + r.height / 2, vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp,
            r: Math.random() * 6, s: (Math.random() - 0.5) * 0.4, c: colors[i % colors.length], l: 1 });
        }
        if (!anim) frame();
      });

      // chiffres qui défilent quand ils apparaissent
      const nums = document.querySelectorAll<HTMLElement>('[data-count]');
      const fmt = new Intl.NumberFormat('fr-FR');
      const io = new IntersectionObserver((es) => es.forEach((en) => {
        if (!en.isIntersecting) return;
        io.unobserve(en.target);
        const el = en.target as HTMLElement, to = Number(el.dataset.count), t0 = performance.now();
        if (reduceMotion) return;
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 1400), v = Math.round(to * (1 - Math.pow(1 - k, 3)));
          el.textContent = fmt.format(v).replace(/\u202f|\u00a0/g, ' ');
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }), { threshold: 0.6 });
      nums.forEach((n) => io.observe(n));
    </script>
  </body>
</html>

<style is:global>
  /* Mise en page inspirée des pages produit : grandes bandes plein écran alternant
     noir, blanc et gris perle, titres très serrés, tuiles à coins arrondis. */
  :root {
    --night: #000000;
    --ink: #1d1d1f;
    --paper: #ffffff;
    --pearl: #f5f5f7;
    --muted: #6e6e73;
    --muted-dark: #a1a1a6;
    --spark: #ff7a18;
    --spark-hot: #ffd23f;
    --link: #d9480f;
    --link-dark: #ff9a4d;
    --display: 'Plus Jakarta Sans', -apple-system, 'Segoe UI', Roboto, sans-serif;
    --brand: 'Lilita One', 'Plus Jakarta Sans', system-ui, sans-serif;
    --gutter-l: max(22px, env(safe-area-inset-left, 0px));
    --gutter-r: max(22px, env(safe-area-inset-right, 0px));
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 64px; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--display);
    font-size: 17px;
    line-height: 1.47;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  img { max-width: 100%; height: auto; display: block; }
  [hidden] { display: none !important; }
  a { color: inherit; }
  h1, h2, h3 { text-wrap: balance; margin: 0; }
  :focus-visible { outline: 2px solid var(--spark); outline-offset: 3px; border-radius: 6px; }

  .wrap { max-width: 1024px; margin-inline: auto; padding-left: var(--gutter-l); padding-right: var(--gutter-r); }

  /* barre de navigation translucide */
  .gnav { position: sticky; top: 0; z-index: 50; }
  .gnav-in {
    height: 48px; display: flex; align-items: center; gap: 28px;
    padding-left: var(--gutter-l); padding-right: var(--gutter-r);
    background: rgb(22 22 23 / 0.8); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
    color: #e8e8ed;
  }
  .wordmark { font-family: var(--brand); font-size: 19px; letter-spacing: 0.02em; text-decoration: none; color: #fff; white-space: nowrap; }
  .gnav-links { display: flex; gap: 26px; list-style: none; margin: 0 auto; padding: 0; font-size: 12.5px; }
  .gnav-links a { text-decoration: none; opacity: 0.86; }
  .gnav-links a:hover { opacity: 1; }
  .gnav-cta {
    font-size: 12.5px; font-weight: 600; text-decoration: none; color: #fff; white-space: nowrap;
    background: var(--spark); padding: 5px 13px; border-radius: 980px; margin-left: auto;
  }
  @media (max-width: 760px) { .gnav-links { display: none; } }

  /* la mèche */
  .fuse { position: relative; height: 3px; background: rgb(255 255 255 / 0.06); }
  .fuse-burn {
    position: absolute; inset: 0 auto 0 0; width: calc(var(--burn, 0) * 100%);
    background: linear-gradient(90deg, #6b3b1f, var(--spark));
  }
  .fuse-spark {
    position: absolute; top: 50%; left: calc(var(--burn, 0) * 100%); width: 10px; height: 10px; margin: -5px 0 0 -5px;
    border-radius: 50%; background: var(--spark-hot);
    box-shadow: 0 0 6px 2px var(--spark-hot), 0 0 16px 6px rgb(255 122 24 / 0.6);
    animation: crackle 0.18s infinite alternate;
  }
  @keyframes crackle { to { transform: scale(1.35); opacity: 0.85; } }
  @media (prefers-reduced-motion: reduce) { .fuse-spark { animation: none; } }

  /* liens d'action « › » */
  .chev { color: var(--link); text-decoration: none; font-size: 19px; }
  .chev::after { content: ' ›'; }
  .chev:hover { text-decoration: underline; }
  .on-dark .chev { color: var(--link-dark); }
  .pill {
    display: inline-block; background: var(--spark); color: #fff; text-decoration: none; font-weight: 600;
    font-size: 17px; padding: 11px 22px; border-radius: 980px;
  }
  .pill:hover { background: #ff8f3a; }

  .pill-xl {
    font-size: 19px; padding: 15px 30px; position: relative;
    background: linear-gradient(180deg, #ff9a3d, #ff6a13); box-shadow: 0 10px 40px -8px rgb(255 106 19 / 0.8), inset 0 1px 0 rgb(255 255 255 / 0.35);
    animation: breathe 2.4s ease-in-out infinite;
  }
  .pill-xl:hover { background: linear-gradient(180deg, #ffab55, #ff7a22); transform: translateY(-1px); }
  @keyframes breathe { 50% { box-shadow: 0 10px 60px -4px rgb(255 106 19 / 1), inset 0 1px 0 rgb(255 255 255 / 0.35); } }
  @media (prefers-reduced-motion: reduce) { .pill-xl { animation: none; } }

  /* barre flottante (téléphone) */
  .dock {
    position: fixed; z-index: 60; left: max(12px, env(safe-area-inset-left, 0px)); right: max(12px, env(safe-area-inset-right, 0px));
    bottom: calc(12px + env(safe-area-inset-bottom, 0px)); display: none; align-items: center; gap: 10px; padding: 8px 8px 8px 12px;
    border-radius: 20px; background: rgb(22 22 23 / 0.86); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    color: #fff; text-decoration: none; box-shadow: 0 20px 50px -10px rgb(0 0 0 / 0.6);
    transform: translateY(140%); transition: transform 0.35s cubic-bezier(.2, .9, .3, 1.2);
  }
  .dock.on { transform: none; }
  .dock img { width: 40px; height: auto; }
  .dock span:not(.dock-btn) { display: grid; line-height: 1.2; flex: 1; min-width: 0; }
  .dock strong { font-family: var(--brand); font-weight: 400; font-size: 17px; letter-spacing: 0.02em; }
  .dock small { color: var(--muted-dark); font-size: 12px; }
  .dock-btn { background: var(--spark); border-radius: 14px; padding: 10px 16px; font-weight: 700; font-size: 15px; }
  @media (max-width: 760px) { .dock { display: flex; } }
  .confetti { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 80; }

  /* pied de page */
  .foot { background: var(--pearl); color: var(--muted); font-size: 12px; line-height: 1.5; }
  .foot-in { max-width: 1024px; margin-inline: auto; padding: 22px var(--gutter-r) 30px var(--gutter-l); display: grid; gap: 18px; }
  .foot-note { margin: 0; padding-bottom: 16px; border-bottom: 1px solid #d2d2d7; }
  .foot-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 18px; }
  .foot-cols h3 { font-size: 12px; color: var(--ink); font-weight: 600; margin-bottom: 8px; }
  .foot-cols a { display: block; text-decoration: none; margin-bottom: 6px; }
  .foot-cols a:hover { text-decoration: underline; }
  .foot-legal { margin: 0; padding-top: 16px; border-top: 1px solid #d2d2d7; }
</style>
